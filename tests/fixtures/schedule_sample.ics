BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Sample//Schedule//EN
BEGIN:VEVENT
UID:one-off
DTSTART;TZID=Asia/Jerusalem:20261116T090000
DTEND;TZID=Asia/Jerusalem:20261116T100000
SUMMARY:Team sync\, weekly planning with a very long title that keeps going
 and going until it must be cut off by the card
END:VEVENT
BEGIN:VEVENT
UID:allday
DTSTART;VALUE=DATE:20261115
DTEND;VALUE=DATE:20261116
SUMMARY:Family day
END:VEVENT
BEGIN:VEVENT
UID:utc
DTSTART:20261115T150000Z
SUMMARY:Call from UTC
BEGIN:VALARM
TRIGGER:-PT15M
ACTION:DISPLAY
DESCRIPTION:Reminder text that is not a title
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:daily
DTSTART;TZID=Asia/Jerusalem:20261101T080000
RRULE:FREQ=DAILY;INTERVAL=1;COUNT=30
EXDATE;TZID=Asia/Jerusalem:20261116T080000
SUMMARY:Morning walk
END:VEVENT
BEGIN:VEVENT
UID:weekly
DTSTART;TZID=Asia/Jerusalem:20261101T180000
RRULE:FREQ=WEEKLY;BYDAY=SU,MO
SUMMARY:Evening class
END:VEVENT
BEGIN:VEVENT
UID:cancelled
DTSTART;TZID=Asia/Jerusalem:20261115T120000
STATUS:CANCELLED
SUMMARY:Cancelled thing
END:VEVENT
BEGIN:VEVENT
UID:badzone
DTSTART;TZID=Nowhere/Land:20261115T120000
SUMMARY:Unknown zone is skipped
END:VEVENT
BEGIN:VEVENT
UID:broken
DTSTART:not-a-date
SUMMARY:Broken date
END:VEVENT
BEGIN:VEVENT
UID:later
DTSTART;VALUE=DATE:20261201
SUMMARY:Outside the two days
END:VEVENT
